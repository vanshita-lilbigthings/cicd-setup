{
  "name": "node-api",
  "version": "1.0.0",
  "description": "Simple Node.js REST API with CI/CD",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --coverage",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke:test": "playwright test e2e"
  },
  "jest": {
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "coverageDirectory": "coverage"
  },
  "dependencies": {
    "@sentry/node": "^10.55.0",
    "@sentry/profiling-node": "^10.55.0",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "winston": "^3.17.0",
    "zod": "^3.25.49"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "eslint": "^8.57.0",
    "fast-check": "^4.8.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.8.3",
    "supertest": "^6.3.4",
    "wait-on": "^9.0.10"
  }
}
